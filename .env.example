APP_NAME=embedding-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8081

EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_NORMALIZE=true
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_BATCH_SIZE=64
EMBEDDING_MAX_TEXT_LENGTH=8000

# Optional: cap torch CPU threads (0 = let torch decide).
EMBEDDING_NUM_THREADS=0

# Max concurrent inference calls. Default 1 serializes encodes to avoid CPU
# oversubscription. Raise only with a matching EMBEDDING_NUM_THREADS.
EMBEDDING_MAX_CONCURRENCY=1

# Optional internal API key. Leave empty to disable auth.
API_KEY=
